# FinEdu — Variabili d'ambiente richieste
# Copia questo file in .env e compila i valori (il file .env è in .gitignore)

# ── Claude API ──────────────────────────────────────────────────────────────
# Obbligatoria per l'integrazione GenAI in produzione
# Ottieni la chiave su console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modello per risposte rapide (chat, analisi breve)
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Modello per analisi complesse (storico multi-mese, confronti)
CLAUDE_MODEL_SMART=claude-sonnet-5

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Solo per la versione produzione (il prototipo usa file JSON)
DATABASE_URL=postgresql://finedu_user:password@localhost:5432/finedu_db

# ── Redis (rate limiting e sessioni) ───────────────────────────────────────
# Solo per la versione produzione
REDIS_URL=redis://localhost:6379/0

# ── Applicazione ───────────────────────────────────────────────────────────
# Ambiente: development | production
APP_ENV=development

# Chiave segreta per JWT (minimo 32 caratteri casuali)
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-con-valore-casuale-sicuro

# Durata access token in minuti
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# ── Rate limiting GenAI ─────────────────────────────────────────────────────
RATE_LIMIT_FREE_DAILY=10
RATE_LIMIT_PREMIUM_DAILY=100

# ── Blob storage (file CSV/PDF caricati) ───────────────────────────────────
# Azure Blob Storage (produzione su Azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=finedu-uploads

# Alternativa: cartella locale (solo sviluppo)
LOCAL_UPLOAD_DIR=app/data/uploads

# ── Stripe (pagamenti tier Premium) ────────────────────────────────────────
# Solo per la versione produzione con monetizzazione attiva
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
